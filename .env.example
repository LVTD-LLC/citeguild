# If you deploying via docker compose you don't need to update these values:
# - POSTGRES_HOST
# - POSTGRES_PORT
# - REDIS_HOST
# - REDIS_PORT

# should be 'off' in prod
DEBUG=on

# options:
# - dev (for local development)
# - prod (for deployed versions)
ENVIRONMENT=dev

# Stdlib logging defaults to readable console output in dev and JSON in prod.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=
# Defaults to <project>-web or <project>-worker from APP_PROCESS_TYPE.
# SERVICE_NAME=
# Optional deploy/release identifier shared by log backends.
# SERVICE_VERSION=

# Container role for the shared deployment image.
# Required in production containers. Docker Compose overrides this per service.
# Use "server" for the web app and "worker" for the background workers app.
APP_PROCESS_TYPE=

# Optional image override for docker-compose-prod.yml.
# Set to ghcr.io/<owner>/<repository>:latest when pulling the image built by GitHub Actions.
APP_IMAGE=

# Host ports published by docker-compose-local.yml. Change these and SITE_URL
# when running multiple generated projects on one machine.
LOCAL_WEB_PORT=8000
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_MAILHOG_SMTP_PORT=1025
LOCAL_MAILHOG_UI_PORT=8025

LOCAL_MJML_PORT=15500


LOCAL_MINIO_API_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001


SECRET_KEY="super-secret-key"

# Keep this aligned with LOCAL_WEB_PORT.
SITE_URL=http://localhost:8000

# Production HTTPS/security defaults are enabled automatically when ENVIRONMENT=prod.
# Uncomment only if your deployment needs a different value.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Set to False to pause new account creation while keeping existing logins working.
ALLOW_SIGNUPS=True

POSTGRES_HOST=db
POSTGRES_DB=citeguild
POSTGRES_USER=citeguild
POSTGRES_PORT=5432
POSTGRES_PASSWORD=citeguild
# Optional full Postgres URL override. Fly.io Postgres attaches this as DATABASE_URL.
# PGSandbox MCP can also provide a temporary DATABASE_URL for local agent-run tests.
DATABASE_URL=

REDIS_HOST=redis
REDIS_PASSWORD=citeguild
REDIS_PORT=6379
REDIS_DB=0
# Optional full Redis URL override. Leave blank to build it from REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and REDIS_DB.
REDIS_URL=
# Override these when two same-slug clones intentionally share one Redis service.
LOCAL_INSTANCE_ID=citeguild
CACHE_KEY_PREFIX=citeguild
Q_CLUSTER_NAME=citeguild-q

# If you want to enable Social Auth via Github
# Get his values after creating a new app on GitHub: https://github.com/settings/applications/new
# For Homepage URL use: http://localhost:8000
# For Authorization callback URL use: http://localhost:8000/accounts/github/login/callback/
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# If you want to load blog post images to S3, instead of local storage
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=citeguild
AWS_SECRET_ACCESS_KEY=citeguild
AWS_S3_BUCKET_NAME=citeguild

# If you need email sending capabilities
# This is not really necessary in the state of the app
# Apart from confirming the email.
# If you don't specify the key you will get the link to confirm email
# in your logs
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.citeguild.app
DEFAULT_FROM_EMAIL=LVTD LLC from CiteGuild <hello@citeguild.app>
SERVER_EMAIL=CiteGuild Errors <error@citeguild.app>

# Optional outbound Healthchecks ping prefix. Leave empty to disable pings.
# Healthchecks.io example: https://hc-ping.com
# Self-hosted example: https://healthchecks.example.com/ping
HEALTHCHECKS_PING_BASE_URL=

# Stripe Integration, not needed unless you want to sell access
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# MJML URL for self-hosted server
MJML_URL=http://mjml:15500

# Internal admin notifications through an Apprise API saved config key.
# Keep Slack/webhook tokens inside Apprise, not in this app's environment.
APPRISE_API_URL=
APPRISE_CONFIG_KEY=citeguild
APPRISE_BASIC_AUTH_USER=
APPRISE_BASIC_AUTH_PASSWORD=
APPRISE_NOTIFICATION_FORMAT=markdown
APPRISE_REQUEST_TIMEOUT=10
ADMIN_NOTIFICATION_EMAIL_FALLBACK=true
ADMIN_NOTIFICATION_EMAIL_RECIPIENTS=LVTD LLC <rasul@lvtd.dev>

# Pydantic AI uses OpenRouter by default so one API key can route to any supported model.
# The slim Pydantic AI package installs the OpenAI-compatible client used by OpenRouter.
# Model values are OpenRouter model ids.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5-nano
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4.5

SENTRY_DSN=
# Set False to force-disable Sentry even when SENTRY_DSN is configured.
SENTRY_ENABLED=True
# Optional Sentry-specific override; defaults to SERVICE_VERSION.
# SENTRY_RELEASE=
# HTTP/web transaction sample rate after healthcheck/static/media filters.
SENTRY_TRACES_SAMPLE_RATE=1.0
# Background/task transaction sample rate for workers, cron-like jobs, and queue work.
SENTRY_BACKGROUND_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=True
SENTRY_BREADCRUMB_LEVEL=INFO
SENTRY_EVENT_LEVEL=ERROR
SENTRY_LOGS_LEVEL=WARNING
SENTRY_SEND_DEFAULT_PII=False
SENTRY_INCLUDE_LOCAL_VARIABLES=False
SENTRY_MAX_BREADCRUMBS=100
SENTRY_DJANGO_MIDDLEWARE_SPANS=True
SENTRY_DJANGO_CACHE_SPANS=True
# PostHog product analytics and privacy-filtered batched OTLP logs.
POSTHOG_API_KEY=
# Server-side ingestion endpoint.
POSTHOG_HOST=https://us.i.posthog.com
# Prefer a first-party reverse proxy in production; defaults to POSTHOG_HOST.
POSTHOG_BROWSER_HOST=
# POSTHOG_LOGS_ENABLED=False
POSTHOG_LOG_LEVEL=INFO
# Opt in to content-free Pydantic AI model and embedding performance traces.
POSTHOG_AI_OBSERVABILITY_ENABLED=False
POSTHOG_SERVICE_NAME=citeguild

# Chatwoot support chat. Leave either base URL or token empty to disable the widget.
# Self-hosted example: https://chatwoot.yourdomain.com
# Chatwoot Cloud example: https://app.chatwoot.com
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
# Optional but recommended: enable Identity Validation in the Chatwoot Website inbox and paste the HMAC token here.
CHATWOOT_HMAC_SECRET=
