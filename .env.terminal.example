# Copy this file to `.env` when running the generated app directly on your
# machine without Docker. Keep `.env.example` for Docker Compose defaults.

DEBUG=on
ENVIRONMENT=dev

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=
# SERVICE_NAME=
# SERVICE_VERSION=

SECRET_KEY="super-secret-key"
# If you start Django with `DJANGO_RUNSERVER_PORT=<port> make terminal-web`,
# update SITE_URL to the same port.
SITE_URL=http://localhost:8000
ALLOW_SIGNUPS=True

# Local Postgres. Create this database/user locally or replace these values
# with DATABASE_URL for your own local Postgres service.
POSTGRES_HOST=localhost
POSTGRES_DB=citeguild
POSTGRES_USER=citeguild
POSTGRES_PORT=5432
POSTGRES_PASSWORD=citeguild
DATABASE_URL=

# Local Redis without a password, matching common package-manager installs.
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Override these when two same-slug clones intentionally share one Redis service.
LOCAL_INSTANCE_ID=citeguild
CACHE_KEY_PREFIX=citeguild
Q_CLUSTER_NAME=citeguild-q

# Local Compose Qdrant uses a persisted volume and development-only API key.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=citeguild
QDRANT_TIMEOUT_SECONDS=5

CITEGUILD_INDEXING_ENABLED=False
CITEGUILD_BILLING_ENABLED=False
CITEGUILD_QDRANT_COLLECTION=citeguild-articles
CITEGUILD_EMBEDDING_MODEL=openrouter:openai/text-embedding-3-small
CITEGUILD_EMBEDDING_DIMENSIONS=1536
CITEGUILD_CRAWL_REQUEST_TIMEOUT_SECONDS=20
CITEGUILD_CRAWL_MAX_REDIRECTS=5
CITEGUILD_CRAWL_MAX_SITEMAP_BYTES=10000000
CITEGUILD_CRAWL_MAX_SITEMAP_ENTRIES=50000
CITEGUILD_CRAWL_MAX_PAGE_BYTES=5000000
CITEGUILD_CRAWL_CONCURRENCY=4
CITEGUILD_EXTRACTION_MIN_TEXT_CHARS=200
CITEGUILD_EXTRACTION_MAX_TEXT_CHARS=500000
CITEGUILD_EXTRACTION_MAX_TREE_SIZE=100000
CITEGUILD_RECONCILE_INTERVAL_HOURS=24

# Print development emails to the terminal so Mailhog is not required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Leave blank for local filesystem media storage when Minio is not running.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=citeguild

MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.citeguild.app
DEFAULT_FROM_EMAIL=LVTD LLC from CiteGuild <hello@citeguild.app>
SERVER_EMAIL=CiteGuild Errors <error@citeguild.app>

# Leave empty unless a task calls ping_healthchecks(...).
HEALTHCHECKS_PING_BASE_URL=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Leave blank unless a local MJML HTTP server is running.
MJML_URL=

APPRISE_API_URL=
APPRISE_CONFIG_KEY=citeguild
APPRISE_BASIC_AUTH_USER=
APPRISE_BASIC_AUTH_PASSWORD=
APPRISE_NOTIFICATION_FORMAT=markdown
APPRISE_REQUEST_TIMEOUT=10
ADMIN_NOTIFICATION_EMAIL_FALLBACK=true
ADMIN_NOTIFICATION_EMAIL_RECIPIENTS=LVTD LLC <rasul@lvtd.dev>

OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5-nano
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4.5

SENTRY_DSN=
SENTRY_ENABLED=True
# Optional Sentry-specific override; defaults to SERVICE_VERSION.
# SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_BROWSER_ENABLED=True
SENTRY_BROWSER_TRACES_SAMPLE_RATE=1.0
SENTRY_BACKGROUND_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=True
SENTRY_BREADCRUMB_LEVEL=INFO
SENTRY_EVENT_LEVEL=ERROR
SENTRY_LOGS_LEVEL=WARNING
SENTRY_SEND_DEFAULT_PII=False
SENTRY_INCLUDE_LOCAL_VARIABLES=False
SENTRY_MAX_BREADCRUMBS=100
SENTRY_DJANGO_MIDDLEWARE_SPANS=True
SENTRY_DJANGO_CACHE_SPANS=True
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LOGS_ENABLED=False
POSTHOG_LOG_LEVEL=INFO
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_SECRET=
