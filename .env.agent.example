# Copy this file to `.env` when an AI coding agent should run Django,
# tests, workers, and assets on the host while Docker Compose provides
# Postgres, Redis, Mailhog, and optional local service emulators.

DEBUG=on
ENVIRONMENT=dev

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=
# SERVICE_NAME=
# SERVICE_VERSION=

SECRET_KEY="super-secret-key"
# Keep this aligned with `LOCAL_WEB_PORT` or `DJANGO_RUNSERVER_PORT`.
SITE_URL=http://localhost:8000
ALLOW_SIGNUPS=True

# Host ports published by docker-compose-local.yml. Change these when running
# multiple generated projects on one machine, then update the matching
# POSTGRES_PORT, REDIS_PORT, EMAIL_PORT, URLs, and SITE_URL values below.
LOCAL_WEB_PORT=8000
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_MAILHOG_SMTP_PORT=1025
LOCAL_MAILHOG_UI_PORT=8025

LOCAL_MJML_PORT=15500


LOCAL_MINIO_API_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001


# Optional Docker Compose namespace. Set this when running two clones with the
# same directory name or same generated project slug.
# COMPOSE_PROJECT_NAME=citeguild-agent

# Connect host-run Django to Compose-published Postgres.
POSTGRES_HOST=localhost
POSTGRES_DB=citeguild
POSTGRES_USER=citeguild
POSTGRES_PORT=5432
POSTGRES_PASSWORD=citeguild
DATABASE_URL=

# Connect host-run Django and Django Q2 to Compose-published Redis.
REDIS_HOST=localhost
REDIS_PASSWORD=citeguild
REDIS_PORT=6379
REDIS_DB=0
# Leave REDIS_URL blank so REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and REDIS_DB
# stay authoritative when LOCAL_REDIS_PORT changes. Set a full URL only for an
# external Redis service.
REDIS_URL=

# Override these when two same-slug clones intentionally share one Redis service.
LOCAL_INSTANCE_ID=citeguild
CACHE_KEY_PREFIX=citeguild
Q_CLUSTER_NAME=citeguild-q

# Leave blank unless this checkout should connect to a Qdrant instance.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5

CITEGUILD_INDEXING_ENABLED=False
CITEGUILD_BILLING_ENABLED=False
CITEGUILD_QDRANT_COLLECTION=citeguild-articles
CITEGUILD_EMBEDDING_MODEL=openai/text-embedding-3-small
CITEGUILD_EMBEDDING_DIMENSIONS=1536
CITEGUILD_CRAWL_REQUEST_TIMEOUT_SECONDS=20
CITEGUILD_CRAWL_MAX_REDIRECTS=5
CITEGUILD_CRAWL_MAX_SITEMAP_BYTES=10000000
CITEGUILD_CRAWL_MAX_SITEMAP_ENTRIES=50000
CITEGUILD_CRAWL_MAX_PAGE_BYTES=5000000
CITEGUILD_CRAWL_CONCURRENCY=4
CITEGUILD_EXTRACTION_MIN_TEXT_CHARS=200
CITEGUILD_EXTRACTION_MAX_TEXT_CHARS=500000
CITEGUILD_EXTRACTION_MAX_TREE_SIZE=100000
CITEGUILD_RECONCILE_INTERVAL_HOURS=24

# Print development emails to the terminal so agent runs do not require Mailhog.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


# Keep this aligned with LOCAL_MINIO_API_PORT when using Minio from the host.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=citeguild
AWS_SECRET_ACCESS_KEY=citeguild
AWS_S3_BUCKET_NAME=citeguild


MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.citeguild.app
DEFAULT_FROM_EMAIL=LVTD LLC from CiteGuild <hello@citeguild.app>
SERVER_EMAIL=CiteGuild Errors <error@citeguild.app>


# Leave empty unless a task calls ping_healthchecks(...).
HEALTHCHECKS_PING_BASE_URL=



STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=



# Keep this aligned with LOCAL_MJML_PORT when using the MJML Compose service.
MJML_URL=http://localhost:15500



APPRISE_API_URL=
APPRISE_CONFIG_KEY=citeguild
APPRISE_BASIC_AUTH_USER=
APPRISE_BASIC_AUTH_PASSWORD=
APPRISE_NOTIFICATION_FORMAT=markdown
APPRISE_REQUEST_TIMEOUT=10
ADMIN_NOTIFICATION_EMAIL_FALLBACK=true
ADMIN_NOTIFICATION_EMAIL_RECIPIENTS=LVTD LLC <rasul@lvtd.dev>



OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-5-nano
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-4.5



SENTRY_DSN=
SENTRY_ENABLED=True
# Optional Sentry-specific override; defaults to SERVICE_VERSION.
# SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_BACKGROUND_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=True
SENTRY_BREADCRUMB_LEVEL=INFO
SENTRY_EVENT_LEVEL=ERROR
SENTRY_LOGS_LEVEL=WARNING
SENTRY_SEND_DEFAULT_PII=False
SENTRY_INCLUDE_LOCAL_VARIABLES=False
SENTRY_MAX_BREADCRUMBS=100
SENTRY_DJANGO_MIDDLEWARE_SPANS=True
SENTRY_DJANGO_CACHE_SPANS=True


POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LOGS_ENABLED=False
POSTHOG_LOG_LEVEL=INFO


CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_HMAC_SECRET=
